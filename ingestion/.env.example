# Same database as the backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_opportunity_finder
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Identify yourself honestly to the sites you fetch from.
# Put a real contact address here so a site owner can reach you.
INGEST_USER_AGENT=StudentOpportunityFinder/1.0 (college project; contact: you@college.edu)

INGEST_TIMEOUT=20
INGEST_RATE_LIMIT=1.5
INGEST_MAX_PAGES=3
