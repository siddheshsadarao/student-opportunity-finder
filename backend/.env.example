# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# The .env file is listed in .gitignore and must never be committed.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_opportunity_finder
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JSON Web Token settings
# Use a long random string in production (e.g. output of: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Where the React app runs (used for the CORS whitelist)
CLIENT_URL=http://localhost:5173

# Extra origins allowed to call this API, comma separated. Needed only when the
# frontend is hosted elsewhere (e.g. Netlify) AND calls this host directly
# instead of going through the Netlify /api proxy.
# EXTRA_ORIGINS=https://your-site.netlify.app,https://www.yourdomain.com

# Your Netlify site name only (no protocol, no .netlify.app). Setting this also
# allows that site's branch and deploy-preview URLs through CORS.
# NETLIFY_SITE_NAME=student-opportunity-finder

# Python FastAPI recommendation microservice
RECOMMENDATION_SERVICE_URL=http://127.0.0.1:8000

# Default admin account created by "npm run db:seed"
ADMIN_EMAIL=admin@sof.com
ADMIN_PASSWORD=Admin@123
