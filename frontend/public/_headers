# =============================================================================
#  Netlify response headers
# =============================================================================
#  Like _redirects, this file is copied into dist/ on every build, so it
#  applies to drag-and-drop deploys as well as Git-connected ones.
# =============================================================================

# Security headers for every page.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite puts a content hash in every asset filename (index-oWUJU8jv.js), so an
# asset URL can never change meaning. Safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must NOT be cached, or visitors keep loading the old app after
# you deploy a new build.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
