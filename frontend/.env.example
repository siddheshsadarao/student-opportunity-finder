# ---------------------------------------------------------------------------
# Frontend build-time settings
#
# Vite only exposes variables that start with VITE_, and it bakes them into the
# bundle at BUILD time. Changing one means rebuilding (npm run build).
#
# Never put a secret here. Anything in this file is visible to anyone who opens
# the site and reads the JavaScript.
# ---------------------------------------------------------------------------

# Leave this UNSET for local development and for Netlify deploys that use the
# /api proxy in netlify.toml (the recommended setup). In both cases the app
# calls "/api" on its own origin.
#
# Only set it if you want the browser to call the backend host directly:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
